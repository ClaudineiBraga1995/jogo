generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

// Exemplo de tabela de Usuário
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  dataNasc  DateTime @db.Date
  criadoEm  DateTime @default(now())

  @@map("usuario") // Nome exato da tabela no banco de dados
}

// Exemplo de tabela de Jogo
model Jogo {
  id        String   @id @default(uuid())
  titulo    String
  descricao String?
  pontos    Int      @default(0)
  vidas     Int      @default(0)
  criadoEm  DateTime @default(now())

  @@map("jogo")
}

